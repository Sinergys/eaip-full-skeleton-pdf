dham" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:50%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p class="adham" style="text-indent:7.8pt; text-align:justify"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:9%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">5-босқич</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">Ўзэнергоинспекция</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:50%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p class="adham" style="text-indent:7.8pt; text-align:justify"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">Ўзэнергоинспекция томонидан ташкилий-техник чора-тадбирлар режаси ижросини назорат (мониторинг) қилади.</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">Доимий</span></span></span></span></p></td></tr><tr><td style="border-bottom:1px solid black; width:9%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:50%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p class="adham" style="text-indent:7.8pt; text-align:justify"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td></tr><tr><td rowspan="2" style="border-bottom:1px solid black; width:9%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">6-босқич</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td rowspan="2" style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">Истеъмолчи</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:none; width:50%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p class="adham" style="text-indent:7.8pt; text-align:justify"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">1. Энергия аудитидан ўтказиш натижалари бўйича ҳисоботдаги самарадорликни оширишга қаратилган ташкилий-техник чора-тадбирларни ва эришилган кўрсаткичлар истеъмолчининг йиллик бизнес-режаларга киритилган ҳолда тегишли кузатув кенгашида тасдиқлайди ва ижросини таъминлайди.</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:none; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">Доимий</span></span></span></span></p></td></tr><tr><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:50%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p class="adham" style="text-indent:7.8pt; text-align:justify"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">2. Энергия аудитидан ўтказиш натижалари бўйича ҳисоботдаги ташкилий-техник чора-тадбирлар ижросини «Энергоназорат» платформасига киритиб боради.</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:17%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">Ташкилий-техник чора-тадбирларда белгиланган муддатларда</span></span></span></span></p></td></tr></tbody></table></a></div><div class="BY_DEFAULT"><a id="7168379"></a></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><a id="7168380">Вазирлар Маҳкамасининг 2024 йил 19 октябрдаги 690-сон <a href="javascript:scrollText()">қарорига</a><br />2-ИЛОВА</a></div><div class="ACT_TITLE_APPL"><a id="7168381">Бино ва иншоотларни энергия истеъмолини энергия аудитидан ўтказиш тартиби тўғрисидаги</a></div><div class="ACT_FORM"><a id="7168382">НИЗОМ</a></div><div class="BY_DEFAULT"><a id="7168383"></a></div><div class="TEXT_HEADER_DEFAULT"><a id="7168386">1-боб. Умумий қоидалар</a></div><div class="ACT_TEXT"><a id="7168387">1. Мазкур Низом фойдаланиш майдони 200 квадрат метрдан ортиқ бўлган бино ва иншоотлар, жумладан, кўп квартирали уйлар, ижтимоий соҳа ва жамоат бино ва иншоотларнинг энергия самарадорлиги бўйича энергия аудитидан ўтказиш, энергетика паспортини ишлаб чиқиш ҳамда энергия самарадорлиги тоифасини белгилашнинг умумий қоидалари ва тартибини белгилайди.</a></div><div class="ACT_TEXT"><a id="7168388">Жисмоний шахслар ўзларининг якка тартибдаги уй-жойларини ихтиёрий равишда энергия аудитидан ўтказган тақдирда, ушбу уй-жойларга мазкур Низом талаблари қўлланилади.</a></div><div class="ACT_TEXT"><a id="7168389">2. Энергия аудити янги қурилган, мавжуд, функционал мақсадлари ўзгартирилган (қайта ихтисослаштирилган), реконструкция қилинган, капитал таъмирланган ва модернизация қилинган бино ва иншоотларининг энергетика паспортларини ишлаб чиқиш ва энергияни тежашга қаратилган бошқа тадбирлар давомида амалга оширилади.</a></div><div class="ACT_TEXT"><a id="7168390">3. Энергия аудити бино ва иншоотларнинг истеъмол қиладиган ёқилғи-энергетика ресурслари ҳажми бўйича объектив маълумотларни олиш, энергия самарадорлиги кўрсаткичларини аниқлаш, энергия йўқотишларини камайтириш, иссиқлик йўқотилиш жойларини аниқлаш ва бартараф этиш, энергия тежаш ва энергия самарадорлигини ошириш имкониятларини аниқлаш, энергия самарадорлигини ошириш бўйича техник-иқтисодий асосланган тадбирларни ишлаб чиқиш орқали коммунал харажатларни камайтириш, бино ва иншоотларни ёритиш (шинамлик) даражасини ошириш, энергетика паспортини ишлаб чиқиш, энергия самарадорлиги тоифасини белгилаш мақсадида амалга оширилади.</a></div><div class="ACT_TEXT"><a id="7168391">4. Энергия аудити энергия аудитори томонидан шартнома асосида амалга оширилади.</a></div><div class="ACT_TEXT"><a id="7168392">5. Мазкур Низомда қуйидаги асосий тушунчалар қўлланилади:</a></div><div class="ACT_TEXT"><a id="7168393"><strong>бино ва иншоотларнинг энергетика паспорти</strong> — бино ва иншоотларнинг энергия самарадорлигини тавсифлайдиган, уларнинг иссиқлик-техник ва энергетик тавсифларини ўз ичига олган, шаҳарсозлик нормалари ва қоидалари ҳамда техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатларга мувофиқлигини белгилайдиган ҳужжат;</a></div><div class="ACT_TEXT"><a id="7168395"><strong>«Бино ва иншоотларнинг энергия аудити» электрон платформаси</strong> — энергия аудит якунлари бўйича тайёрланган энергетик паспортни электрон рўйхатдан ўтказиш орқали уларни электрон реестрини ҳамда энергия аудит ташкилотлари электрон рейтингини юритишни ўз ичига оладиган махсус электрон платформа (кейинги ўринларда — Махсус электрон платформа);</a></div><div class="ACT_TEXT"><a id="7168396"><strong>бино ва иншоотларнинг энергия самарадорлиги тоифаси </strong>— бино ва иншоотларнинг ёқилғи-энергетика ресурслари истеъмолини тавсифлайдиган самарадорлик даражаси;</a></div><div class="ACT_TEXT"><a id="7168397"><strong>ёқилғи-энергетика ресурслари</strong> — табиий ва бошқа манбалардан ишлаб чиқариладиган ёқилғи ва энергиянинг барча турлари йиғиндиси;</a></div><div class="ACT_TEXT"><a id="7168398"><strong>энергия аудити </strong>— фойдаланилган ёқилғи-энергетика ресурслари ва энергия самарадорлиги кўрсаткичлари тўғрисидаги ишончли маълумотларни тўплашга, уларга ишлов беришга ҳамда уларни таҳлил қилишга, шунингдек хулоса тайёрлашга қаратилган фаолият;</a></div><div class="ACT_TEXT"><a id="7168399"><strong>энергия аудитори</strong> — энергия истеъмолчиларини энергия аудитидан (энергетика текшируви) ўтказадиган, етарли билим ва тажрибага ҳамда соҳа бўйича малака сертификатларига эга ва белгиланган минимал талабларга жавоб берувчи шахс;</a></div><div class="ACT_TEXT"><a id="7168400"><strong>энергия аудитидан ўтказиш дастури </strong>— объектни энергия аудитидан ўтказиш учун иссиқлик ва энергия хусусиятларини ҳисоблаш ва (ёки) инструментал ўлчаш усуллари ва муддатларини белгиловчи, энергия аудитори томонидан тузиладиган ҳужжат;</a></div><div class="ACT_TEXT"><a id="7168401"><strong>энергияни тежаш</strong> — қурилиш ресурслари ва технологиялари ривожланишини амалдаги даражасида ва атроф-муҳитни муҳофаза қилишга қўйиладиган талабларга риоя қилган ҳолда ёқилғи-энергетика ресурсларидан фойдаланишнинг иқтисодий самарадорлигига эришишга йўналтирилган ҳуқуқий, ташкилий, илмий, ишлаб чиқариш, техник ва иқтисодий чораларни амалга ошириш.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="7168402">2-боб. Энергия аудити турлари</a></div><div class="ACT_TEXT"><a id="7168403">6. Энергия аудитидан ўтказишнинг дастлабки, даврий ва навбатдан ташқари турлари мавжуд.</a></div><div class="ACT_TEXT"><a id="7168405">7. Дастлабки энергия аудитида бино ва иншоотларда ёқилғи-энергетика ресурсидан фойдаланиш самарадорлигига баҳо берилади.</a></div><div class="ACT_TEXT"><a id="7168406">8. Даврий энергия аудитини ўтказишда аввал берилган энергия аудитори томонидан бино ва иншоотларнинг энергия тежамкорлик имкониятларини аниқлаш натижасида энергия самарадорлигини ошириш бўйича кўрсатмаларнинг (кейинги ўринларда — кўрсатма) бажарилиши ҳамда ёқилғи-энергетика ресурслари истеъмоли ва уларнинг бино ва иншоотларининг иситиладиган ҳажми ёки майдон бирлигига иситиш ва совитиш учун ёқилғи-энергетика ресурслари сарфи динамикаси таҳлил қилиниб, баҳо берилади.</a></div><div class="ACT_TEXT"><a id="7168407">Даврий энергия аудити беш йилда камида бир маротаба ўтказилади.</a></div><div class="ACT_TEXT"><a id="7168408">9. Навбатдан ташқари энергия аудити қуйидаги ҳолларда ўтказилади:</a></div><div class="ACT_TEXT"><a id="7168409">ёқилғи-энергетика ресурсларини бино ва иншоотларнинг иситиладиган майдон бирлигига сарфи ортганида;</a></div><div class="ACT_TEXT"><a id="7168410">ёқилғи-энергетика ресурсларидан фойдаланиш самарадорлиги кескин пасайганлиги юзасидан ҳолатлар (фактлар) пайдо бўлганда;</a></div><div class="ACT_TEXT"><a id="7168411">энергия аудитори томонидан ўтказилган энергия аудити ҳаққоний ўтказилмаганлиги аниқланганда.</a></div><div class="ACT_TEXT"><a id="7168412">10. Даврий ва навбатдан ташқари энергия аудити натижалари бўйича бино ва иншоотларнинг энергетика паспортига ўзгартиришлар киритилади, энергия самарадорликни ошириш бўйича таклифлар берилади.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="7168413">3-боб. Энергия аудитини ташкил этиш</a></div><div class="ACT_TEXT"><a id="7168414">11. Энергия аудити бино ва иншоотларнинг эгаси ёки унинг вакилининг энергия аудитидан ўтказиш тўғрисида энергия аудиторига тақдим этиладиган аризасига асосан амалга оширилади.</a></div><div class="ACT_TEXT"><a id="7168415">12. Энергия аудити томонлар ўртасида тузилган шартнома асосида ариза берувчининг (кейинги ўринларда — буюртмачи) маблағлари ҳисобидан ўтказилади.</a></div><div class="ACT_TEXT"><a id="7168416">13. Энергия аудити ўтказилаётган объектнинг мавсумий хусусиятларини ҳисобга олган ҳолда амалга оширилади.</a></div><div class="ACT_TEXT"><a id="7168417">14. Энергия аудитининг мақсади ва вазифалари ушбу соҳада қабул қилинган миллий ва халқаро стандартларга ҳамда энергетика ва экологик хавфсизликни таъминлаш бўйича қонунчилик ҳужжатларида белгиланган талабларга мувофиқ бўлиши керак.</a></div><div class="ACT_TEXT"><a id="7168418">15. Энергия аудити ўтказиш учун энергия аудиторида техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда шаҳарсозлик нормалари ва қоидаларида белгиланган синовларини амалга ошириш учун зарур бўладиган синов ускуналари бўлиши лозим.</a></div><div class="ACT_TEXT"><a id="7168419">16. Энергия аудитори буюртмачиларга уларнинг сўровига биноан бино ва иншоотларни энергия аудитдан ўтказиш дастури ҳамда энергия аудити бўйича режалаштирилган ишлар нархининг калькуляциясини тақдим этиши керак.</a></div><div class="ACT_TEXT"><a id="7168420">17. Энергия аудитидан ўтказиш учун энергия аудиторига тақдим этилган маълумотлар ҳаққонийлигига уни тақдим этган ташкилот жавоб беради.</a></div><div class="ACT_TEXT"><a id="7168421">18. Энергия аудити натижаси бўйича ҳисобот ва тавсиялар, шунингдек, энергетика паспортининг ҳаққонийлигига энергия аудитори жавоб беради.</a></div><div class="ACT_TEXT"><a id="7168422">19. Энергия аудити тугагандан сўнг буюртмачи ишларни қабул қилиш-топшириш далолатномасида кўрсатилган энергия аудити хизматларини қабул қилади.</a></div><div class="ACT_TEXT"><a id="7168423">20. Энергия аудитидан ўтказилаётган бино ва иншоотларнинг эгаси (буюртмачи) аудит доирасида режалаштирилган ишларни амалга оширишда энергия аудиторига кўмаклашиши керак. Бунда буюртмачи:</a></div><div class="ACT_TEXT"><a id="7168424">энергия аудиторининг ходимларини текширилаётган объектларга киришини таъминлаши;</a></div><div class="ACT_TEXT"><a id="7168425">текширув ўтказилиши учун масъул шахс тайинлаши;</a></div><div class="ACT_TEXT"><a id="7168426">технология ва хавфсизлик талабларига зид бўлмаган ҳолларда, тегишли технологик ускуналарни, уларда ўлчовларни ўтказиш учун, зарур бўлган ишлаш режимини ўрнатилишини таъминлаши шарт.</a></div><div class="ACT_TEXT"><a id="7168428">21. Буюртмачи қуйидаги зарур ҳужжатларни энергия аудиторига тақдим этиши шарт:</a></div><div class="ACT_TEXT"><a id="7168429">ёқилғи-энергетика ресурсларининг истеъмоли маълумотларини;</a></div><div class="ACT_TEXT"><a id="7168430">фойдаланилган ёқилғи-энергетика ресурслари бўйича буюртмачининг ўлчов воситалари кўрсаткичлари асосида шакллантирилган статистика ҳисоботларини;</a></div><div class="ACT_TEXT"><a id="7168431">энергетика паспортини (даврий ва навбатдан ташқари энергия аудитини ўтказишда).</a></div><div class="ACT_TEXT"><a id="7168432">22. Буюртмачи бино ва иншоотни энергия аудитдан ўтказиш жараёнида унинг натижасига таъсир қилувчи ҳар қандай ўзгаришлар ҳақида энергия аудиторини ўз вақтида хабардор қилиши лозим. Бунда энергия аудитори бино ва иншоотларни энергия аудити натижасига таъсир кўрсатиши мумкин бўлган ҳолатларни текширади ва ҳисоботда қайд этади.</a></div><div class="ACT_TEXT"><a id="7168433">23. Агар энергия аудитори томонидан ўтказилган энергия аудитининг натижалари ҳаққоний эмаслиги тасдиқланса, ушбу энергия аудитори буюртмачининг ушбу текширув ўтказилиши учун харажатларини ҳамда бунинг натижасида келтирилган зарарларни тўлиқлигича қоплашга мажбурдир.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="7168434">4-боб. Бино ва иншоотларни энергия аудитидан ўтказиш тартиби</a></div><div class="ACT_TEXT"><a id="7168435">24. Бино ва иншоотларни энергия аудитдан ўтказишлари мазкур Низомга <a href="javascript:scrollText(7168509)">1-иловада</a> келтирилган схема бўйича амалга оширилади.</a></div><div class="ACT_TEXT"><a id="7168436">25. Энергия аудитидан ўтказиш учун энергия аудиторлари уларнинг махсус электрон платформада шакллантириб бериладиган рейтинг кўрсаткичлари асосида аниқланади.</a></div><div class="ACT_TEXT"><a id="7168437">Бунда давлат иштирокидаги ташкилотлар ва давлат муассасалари энергия аудиторини Ўзбекистон Республикасининг «Давлат харидлари тўғрисида»ги <a href="http://lex.uz/ru/docs/5382974">Қонунда </a>белгиланган тартибда аниқлайди.</a></div><div class="ACT_TEXT"><a id="7168438">26. Энергия аудитини ўтказиш бўйича шартнома тузиш учун буюртмачининг аризасига қуйидаги ҳужжат ва маълумотлар илова қилинади:</a></div><div class="ACT_TEXT"><a id="7168439">энергия аудитини ўтказиш мақсади ва иш ҳажмини белгилаб берувчи ҳужжат (техник топшириқ);</a></div><div class="ACT_TEXT"><a id="7168440">бино ва иншоотни тавсифловчи маълумотлар: манзили, фойдаланиш тоифаси, бино ва иншоотда яшовчилар (фаолият юритувчилар) сони, қурилган йили, иситиладиган майдони ва ҳажми, иссиқлик таъминоти манбаи;</a></div><div class="ACT_TEXT"><a id="7168441">ёқилғи-энергетика ресурслари истеъмоли тўғрисидаги маълумот (бино ва иншоотларда истеъмол қилинган ёқилғи-энергетика ресурслари ҳисоблагичларининг кўрсаткичлари);</a></div><div class="ACT_TEXT"><a id="7168442">бино ва иншоотларнинг лойиҳа ҳужжатлари (мавжуд бўлганда);</a></div><div class="ACT_TEXT"><a id="7168443">кадастр ҳужжатлари;</a></div><div class="ACT_TEXT"><a id="7168444">бино ва иншоотларда қўлланилаётган ёқилғи-энергетика ресурслари истеъмоли билан боғлик ускуналар ва жиҳозларнинг техник ҳужжатлари;</a></div><div class="ACT_TEXT"><a id="7168445">аввал ўтказилган энергия аудити натижалари бўйича расмийлаштирилган ҳужжатлар (даврий ва навбатдан ташқари энергия аудитини ўтказишда);</a></div><div class="ACT_TEXT"><a id="7168446">энергия менежменти тизими халқаро стандарти (ISO 50001) бўйича сертификати (мавжуд бўлганда).</a></div><div class="ACT_TEXT"><a id="7168447">27. Бино ва иншоотларни энергия аудитидан ўтказишда энергия аудитори бино ва иншоотлар эгаси, бино ва иншоотларда фаолият олиб борувчи ходимлар (кўп квартирали уйларда яшовчилар) билан сўровнома ўтказиш йўли билан қўшимча маълумотларни олиши мумкин.</a></div><div class="ACT_TEXT"><a id="7168448">28. Энергия аудитори буюртмачининг аризаси унга илова қилинган ҳужжатларнинг тўлиқлиги ва тўғрилигини текширади.</a></div><div class="ACT_TEXT"><a id="7168449">29. Буюртмачи томонидан ариза ва унга илова қилинган ҳужжатлар тўлиқ тақдим этилгандан сўнг энергия аудитори буюртмачи билан шартнома имзолаши мумкин.</a></div><div class="ACT_TEXT"><a id="7168450">Бунда давлат буюртмачилари қонунчилик ҳужжатларида белгиланган харид қилиш тартиб-таомиллари натижаларига кўра томонлар ўртасида шартнома тузилганидан сўнг энергия аудиторига тегишли ҳужжатларни топширадилар.</a></div><div class="ACT_TEXT"><a id="7168451">30. Энергия аудитидан ўтказишнинг умумий муддати камида икки ой бўлиши, лекин шартнома тузилган кундан бошлаб бир йилдан ошмаслиги, шунингдек, давлат буюртмачилари учун жорий молия йили доирасида ўтказилиши керак.</a></div><div class="ACT_TEXT"><a id="7168452">31. Бино ва иншоотларни энергия аудитига тайёрлаш босқичида энергия аудитори:</a></div><div class="ACT_TEXT"><a id="7168453">энергия аудитини ўтказиш дастурини шакллантиради ва буюртмачи билан келишади;</a></div><div class="ACT_TEXT"><a id="7168454">буюртмачи томонидан тақдим этилган бино ва иншоотни тавсифловчи маълумотлар асосида бино ва иншоотларни тузилиши (таркиби), уларнинг хусусиятлари ва ҳажм-режавий ечимлари, девор ва том қисмининг материаллари, ойналар тури ва майдони, иситиладиган майдон ва ҳажми, иссиқлик таъминоти манбаи, муҳандислик тизимларини схематик ечимларини ўрганади;</a></div><div class="ACT_TEXT"><a id="7168455">жойига чиққан ҳолда буюртмачи ёки унинг вакили иштирокида объектнинг асосий таркибий элементларининг ҳақиқий ҳолатини унинг лойиҳасига ва энергия паспортига (мавжуд бўлганда) нисбатан, жумладан, ҳажмий-режалаштириш ечимлари, муҳандислик тизимлари ва ускуналари бўйича қиёсий баҳолашдан ўтказади;</a></div><div class="ACT_TEXT"><a id="7168456">тегишли ташкилотлар ва хонадон эгаларидан электр таъминоти, иссиқлик таъминоти, сув таъминоти, газ таъминоти, вентиляция, оқова сув ва совитиш тизимлари, энергетик ва технологик ускуналар, электр энергиясини истеъмол қилувчи қурилманинг қуввати, уларнинг солиштирма энергия сарфи тўғрисидаги маълумотларни, энергия ташувчиси параметрлари, бино ва иншоотларнинг иситиладиган майдон бирлигига иситиш учун ёқилғи-энергетика ресурслари сарфи, ўлчаш воситаларининг охирги уч йиллик кўрсаткичларини шакллантиради (тўплайди);</a></div><div class="ACT_TEXT"><a id="7168457">бино ва иншоотлардан фойдаланиш шароитлари ҳамда тартибини ўрганади.</a></div><div class="ACT_TEXT"><a id="7168458">32. Бино ва иншоотларнинг лойиҳа ҳужжатлари мавжуд бўлмаган тақдирда, ўлчаш ишлари ва ўраб турувчи конструкциялар, муҳандислик тизимлари ва жиҳозларининг техник ҳолатини текшириш натижалари асосида ҳақиқий ҳолатга уларнинг асосланган чизмалари ва схемалари ишлаб чиқилади.</a></div><div class="ACT_TEXT"><a id="7168459">33. Ўлчашлар ва текширишлар ўтказиш босқичида қуйидагилар бажарилади:</a></div><div class="ACT_TEXT"><a id="7168460">бино ва иншоотларнинг техник ҳолати визуал кўрикдан ўтказилади. Бунда, бино ва иншоотнинг конструкциялари, муҳандислик тизимлари ва жиҳозлари техник ҳолати, энергия самарадорлигига салбий таъсир кўрсатувчи нуқсонлари мавжудлиги текширилади. Конструкцияларнинг мустаҳкамлигига баҳо бериш зарурати мавжуд бўлганда, бино ва иншоотларнинг техник ҳолати инструментал текширувдан ўтказилади;</a></div><div class="ACT_TEXT"><a id="7168461">бино ва иншоотнинг тўсувчи конструкциялари (ташқи девор, пойдевор, ойна, ташқи эшиклар, том, чордоқ, ертўла) иссиқлик ҳимояси даражаси, муҳандислик тизимлари (иситиш, электр, сув (иссиқ ва совуқ), газ таъминоти ва вентиляция, кондициялаш, ёритиш тизимлари), лифтлар ва бошқа жиҳозларнинг энергетик тавсифлари, ҳамда бино ва иншоотларнинг микроиқлими техник жиҳатдан тартибга солиш соҳасидаги норматив ҳужжатлар ҳамда шаҳарсозлик нормалари ва қоидаларида белгиланган синов усуллари асосида текширилади;</a></div><div class="ACT_TEXT"><a id="7168462">ёқилғи-энергетика ресурсларининг истеъмоли ҳажми ва йўқотилиш сабаблари аниқланади.</a></div><div class="ACT_TEXT"><a id="7168463">34. Ўлчашлар ва текширишлар ёз ва қиш мавсумида амалга оширилиши керак.</a></div><div class="ACT_TEXT"><a id="7168464">35. Бино ва иншоотларнинг техник ҳолати буюртмачи ёки унинг вакили иштирокида текширилади.</a></div><div class="ACT_TEXT"><a id="7168465">36. Ёқилғи-энергетика ресурсларидан оқилона фойдаланиш параметрларига билвосита (таҳлиллар ва ўлчовларни ўтказмасдан) баҳо беришга йўл қўйилмайди.</a></div><div class="ACT_TEXT"><a id="7168466">37. Таҳлил босқичида энергия аудитори қуйидаги тадбирларни амалга оширади:</a></div><div class="ACT_TEXT"><a id="7168467">тайёргарлик босқичида олинган дастлабки маълумотларни таҳлил қилиш;</a></div><div class="ACT_TEXT"><a id="7168468">ўлчашлар ва текширишлар ўтказиш босқичида олинган маълумотларни таҳлил қилиш;</a></div><div class="ACT_TEXT"><a id="7168469">бино ва иншоотларнинг энергия самарадорлигининг амалдаги кўрсаткичларини ҳисоблаш;</a></div><div class="ACT_TEXT"><a id="7168470">амалдаги кўрсаткичларни белгиланган меъёрий қийматлар билан ўзаро таққослаш;</a></div><div class="ACT_TEXT"><a id="7168471">амалдаги энергия самарадорлиги кўрсаткичлари ва белгиланган меъёрий қийматлар ўртасидаги номувофиқлик сабабларини аниқлаш ва таҳлил қилиш;</a></div><div class="ACT_TEXT"><a id="7168472">бино ва иншоотлар учун мумкин бўлган энергия тежаш қийматларини ҳисоблаш;</a></div><div class="ACT_TEXT"><a id="7168473">бино ва иншоотларнинг энергия самарадорлиги тоифасини белгилаш.</a></div><div class="ACT_TEXT"><a id="7168474">38. Бино ва иншоотларнинг иссиқлик-техник ва энергетик тавсифлари ҳамда энергия самарадорлиги кўрсаткичларини аниқлаш учун ҳисоблаш усуллари техник жиҳатдан тартибга солиш соҳасидаги тегишли норматив ҳужжатлари ҳамда шаҳарсозлик нормалари ва қоидалари билан белгиланади.</a></div><div class="ACT_TEXT"><a id="7168475">39. Якуний босқичда бино ва иншоотларнинг ёқилғи-энергетика ресурсларидан фойдаланиш таҳлили натижалари умумлаштирилади.</a></div><div class="ACT_TEXT"><a id="7168476">40. Энергия аудити натижасида энергия ресурсларини тежаш ва энергия самарадорлигини ошириш бўйича ҳисобот (кейинги ўринларда — Ҳисобот) энергия аудитори томонидан тузилади.</a></div><div class="ACT_TEXT"><a id="7168477">41. Ҳисобот энергия аудиторининг бланкида расмийлаштирилади ва унинг раҳбари томонидан имзоланади.</a></div><div class="ACT_TEXT"><a id="7168478">42. Ҳисобот учта асосий қисмдан иборат бўлади:</a></div><div class="ACT_TEXT"><a id="7168479">кириш қисми — ариза берувчининг ҳамда энергия аудиторининг маълумотлари, тузилган шартноманинг рақами ва энергия аудити объектининг умумий тавсифи кўрсатилади;</a></div><div class="ACT_TEXT"><a id="7168480">асосий қисм — дастлабки маълумотлар таҳлили, ўлчовларни бажариш усуллари ва қўлланилган асбоблар, бино ва иншоотларнинг визуал кўриги ҳамда сўровнома натижалари, ёқилғи-энергетика ресурслари истеъмоли ҳамда электр энергияси таъминоти, иссиқлик таъминоти, газ таъминоти, сув таъминоти тизимлари ҳолати, ўлчашлар ва текширишлар натижалари бўйича ҳисоб-китоблар ва ёқилғи-энергетика ресурсларининг солиштирма сарфини таҳлили келтирилади;</a></div><div class="ACT_TEXT"><a id="7168481">якуний қисм — хулосалар ва техник-иқтисодий жиҳатдан асосланган кўрсатмаларни (кейинги ўринларда — кўрсатмалар) ўз ичига олади.</a></div><div class="ACT_TEXT"><a id="7168482">43. Ҳисоботда ёқилғи-энергетика ресурсларидан фойдаланиш кўрсаткичининг қурилиш нормалари ва қоидалари талабларига мувофиқлиги, улардан фойдаланишдаги йўл қўйилган камчиликлар кўрсатилиши, объектнинг энергия тежашнинг мумкин бўлган имкониятлари бўйича маълумот берилиши керак.</a></div><div class="ACT_TEXT"><a id="7168483">44. Ҳисобот бино ва иншоотнинг энергия паспортини шакллантириш ва энергия самарадорлиги тоифасини белгилаш учун асос бўлади.</a></div><div class="ACT_TEXT"><a id="7168484">45. Кўрсатмаларда бино ва иншоотлар майдони бирлигига иситиш учун ёқилғи-энергетика ресурсларини камайтиришни ҳисобга олган ҳолда, энергияни тежаш ва объектнинг энергия самарадорлигини ошириш бўйича техник-иқтисодий жиҳатдан асосланган ва уларни бажариш муддатлари кўрсатилган чора-тадбирлар назарда тутилади.</a></div><div class="ACT_TEXT"><a id="7168485">46. Кўрсатмада келтирилган тадбирларнинг иқтисодий самарадорлиги ва қопланиш муддатлари, рентабеллиги асослантирилади.</a></div><div class="ACT_TEXT"><a id="7168486">47. Техник жиҳатдан имконият бўлган тақдирда бино ва иншоотларда иккиламчи энергетика ресурсларидан ҳамда қайта тикланувчи энергия манбаларидан фойдаланиш бўйича ташкилий-техник чора-тадбирлар юзасидан тавсиялар қилинади.</a></div><div class="ACT_TEXT"><a id="7168487">48. Кўрсатмалар ишлаётган асбоб-ускуналар ва технологик жараёнларнинг экологик тавсифини, ходимлар ишининг хавфсизлиги ва қулайлиги даражасини камайтирилмаслигини таъминлаши зарур.</a></div><div class="ACT_TEXT"><a id="7168488">49. Энергия аудитори кўрсатмаларни бажариш бўйича режа-жадвал ишлаб чиқади ва уни буюртмачи билан келишади.</a></div><div class="ACT_TEXT"><a id="7168489">50. Бино ва иншоотларнинг энергия аудити натижаларига кўра энергия аудитори энергетика паспортини шакллантиради.</a></div><div class="ACT_TEXT"><a id="7168490">51. Бино ва иншоотларнинг энергия самарадорлиги тоифаси мазкур Низомга <a href="javascript:scrollText(7168515)">2-иловада</a> келтирилган жадвалга мувофиқ энергия ресурсларининг истеъмоли қийматининг оғиш катталиги (энергия самарадорлик индекси) бўйича аниқланади.</a></div><div class="ACT_TEXT"><a id="7168491">Бунда фойдаланиш майдони 200 квадрат метрдан ортиқ бўлган бино ва иншоотларнинг энергия самарадорлиги тоифасини аниқлаш учун «A», «B», «C», «D», «E», «F» ва «G» белгиларидан фойдаланилади.</a></div><div class="ACT_TEXT"><a id="7168492">52. Кўрсатмалар энергия самарадорлиги тоифаси «D» ва ундан паст бўлган бино ва иншоотлар учун бажарилиши мажбурий ҳисобланади (якка тартибдаги уй-жойлар бундан мустасно).</a></div><div class="ACT_TEXT"><a id="7168493">53. Энергия аудити натижалари бўйича тайёрланган ҳисобот, кўрсатмалар ва бино ва иншоотларнинг энергетика паспорти энергия аудитори томонидан тасдиқлангандан сўнг бир иш кунида Махсус электрон платформага жойлаштирилади.</a></div><div class="ACT_TEXT"><a id="7168494">54. Қурилиш ва уй-жой коммунал хўжалиги вазирлиги (кейинги ўринларда — Вазирлик) ўн иш кунида Махсус электрон платформага жойлаштирилган бино ва иншоотларнинг энергия аудити якунлари бўйича тайёрланган ҳисоботи ва энергетика паспортининг мазкур Низом талабларига мувофиқлигини, берилган кўрсатмаларнинг самарадорлигини ва уларнинг техник-иқтисодий жиҳатдан асосланганини, шу жумладан, энергетика паспорти кўрсаткичлари тўғрилигини кўриб чиқади.</a></div><div class="ACT_TEXT"><a id="7168495">55. Ҳисобот ва паспорт тўғри ишлаб чиқилган бўлса, улар уч иш куни ичида Махсус электрон платформада рўйхатдан ўтказилади ва энергетика паспортига тегишли реестр рақами берилади.</a></div><div class="ACT_TEXT"><a id="7168496">56. Расмийлаштирилган ҳисобот ва энергетика паспорти мазкур Низомнинг <a href="javascript:scrollText(7168416)">13</a>, <a href="javascript:scrollText(7168417)">14</a>, <a href="javascript:scrollText(7168435)">24</a>, <a href="javascript:scrollText(7168451)">30</a>, <a href="javascript:scrollText(7168463)">34</a> ҳамда <a href="javascript:scrollText(7168477)">41 — 49 бандлари </a>талабларга мувофиқ эмас деб топилса, Вазирлик бир иш кунида аниқлаган камчиликларни асослантирилган ҳолда уларни энергия аудиторига қайтаради.</a></div><div class="ACT_TEXT"><a id="7168497">57. Энергия аудитори Вазирлик томонидан тақдим этилган таклифларни инобатга олган ҳолда, энергия аудити натижаси бўйича ҳисобот ва паспортни қайта ишлаб чиқади (тўлдиради) ва такроран махсус платформага киритади.</a></div><div class="ACT_TEXT"><a id="7168498">Бунда ҳисобот ва энергетика паспортини қайта ишлашга қайтариш ва қайта киритиш Махсус электрон платформа орқали амалга оширилади.</a></div><div class="ACT_TEXT"><a id="7168499">58. Ҳисобот ва энергетика паспорти Вазирлик томонидан белгиланган тартибда Махсус электрон платформада рўйхатдан ўтказилгунига қадар энергия аудити тугатилган деб ҳисобланмайди.</a></div><div class="ACT_TEXT"><a id="7168500">59. Ҳисобот ва энергетика паспорти Махсус электрон платформада рўйхатдан ўтгандан сўнг унга ўзгартириш ва қўшимчалар киритиш тақиқланади.</a></div><div class="ACT_TEXT"><a id="7168502">60. Махсус электрон платформада ҳисобот ва энергетика паспорти рўйхатдан ўтказиш орқали энергетика паспортларнинг электрон реестри шакллантирилади.</a></div><div class="ACT_TEXT"><a id="7168501">61. Энергия аудиторлари тўғрисидаги маълумотлар Махсус электрон платформада юритилади ва энергия аудиторларнинг рейтингини шакллантиришда фойдаланилади.</a></div><div class="ACT_TEXT"><a id="7168503">62. Кўрсатмани бажариш бўйича белгиланган ишларнинг ўз вақтида сифатли бажарилиши қонунчилик ҳужжатларида белгиланган тартибда Қурилиш ва уй-жой коммунал хўжалиги соҳасида ҳудудий назорат қилиш инспекцияси ҳамда туман (шаҳар) қурилиш ва уй-жой коммунал хўжалиги бўлимлари (Тошкент шаҳрида — туман қурилиш бўлимлари) (кейинги ўринларда — назорат қилувчи орган) томонидан назорат қилинади.</a></div><div class="ACT_TEXT"><a id="7168504">63. Назорат қилувчи орган Махсус электрон платформа орқали кўрсатмани олади ва уни бажариш бўйича ишларни ўз вақтида, шаҳарсозлик нормалари ва қоидаларида белгиланган талабларга мувофиқ, режалаштирилган ишларни сифатли бажарилишини назорат қилинади.</a></div><div class="TEXT_HEADER_DEFAULT"><a id="7168505">5-боб. Якунловчи қоидалар</a></div><div class="ACT_TEXT"><a id="7168506">64. Энергия аудитори энергия аудити ўтказилишида буюртмачининг хўжалик фаолиятига аралашмасликка ҳамда тўсқинлик қилмасликка, давлат ва тижорат сирларига риоя қилишга ҳамда шартнома шартларининг бажарилиши тўлақонли таъминлашга мажбурдир.</a></div><div class="ACT_TEXT"><a id="7168507">65. Энергия аудитори томонидан ўтказилган энергия аудити натижалари ҳаққоний эмаслиги бир неча бор тасдиқланган тақдирда, ушбу энергия аудиторига нисбатан қонунчилик ҳужжатларида белгиланган чораларни кўриш учун тегишли органга таклиф киритишга асос бўлади.</a></div><div class="ACT_TEXT"><a id="7168508">66. Ушбу Низом талабларининг бузилишида айбдор бўлган шахслар қонунчилик ҳужжатларида белгиланган тартибда жавоб беради.</a></div><div class="BY_DEFAULT"><a id="7168509"></a></div><div class="APPL_BANNER_LANDSCAPE_TITLE"><a id="7168510">Бино ва иншоотларни энергия истеъмолини энергия аудитидан ўтказиш тартиби тўғрисидаги <a href="javascript:scrollText(7168381)">низомга</a><br />1-ИЛОВА</a></div><div class="ACT_TITLE_APPL"><a id="7168511">Бино ва иншоотларни энергия аудитидан ўтказиш</a></div><div class="ACT_FORM"><a id="7168512">СХЕМАСИ</a></div><div class="BY_DEFAULT"><a id="7168513"></a></div><div class="BY_DEFAULT"><a id="7168514"><table class="Table" style="width:100.0%; border-collapse:collapse" width="100%"><tbody><tr><td rowspan="2" style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:1px solid black"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold">Босқичлар</span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td rowspan="2" style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold">Субъектлар</span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td rowspan="2" style="border-bottom:1px solid black; width:50%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold">Чора-тадбирлар</span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td rowspan="2" style="border-bottom:1px solid black; width:19%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:1px solid black; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold">Бажариш муддатлари</span></span></span></p></td></tr><tr><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:50%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:19%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:none; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td></tr><tr><td style="border-bottom:1px solid black; width:8%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:1px solid black"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">1-босқич</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"></p></td><td style="border-bottom:1px solid black; width:15%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center"><span style="font-size:12pt"><span style="font-family:&quot;Times New Roman&quot;,serif"><span style="font-weight:bold"><span lang="UZ-CYR" style="font-weight:normal">Буюртмачи</span></span></span></span></p></td><td style="border-bottom:none; width:1%; padding:0cm 4px 0cm 4px; height:19px; background-color:white; border-top:none; border-right:1px solid black; border-left:none"><p align="center" class="adham" style="text-align:center