# ============ Critical Settings ============
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============ Paths ============
TEMP_DIR=/tmp
GOST_TEMPLATE_PATH=../../../templates/pcm690/energy_audit_template.docx

# ============ Database ============
VALIDATOR_DATABASE_URL=sqlite:///./word_validator_cache.db

# ============ Ollama (Local AI) ============
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT=300

# ============ DeepSeek API (Cloud AI) ============
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=4000
DEEPSEEK_TIMEOUT=300

# ============ Processing Configuration ============
MAX_FILE_SIZE_MB=100
CHUNK_SIZE_TOKENS=20000
MAX_RETRIES=2
RETRY_DELAY_SECONDS=5

# ============ Cache Configuration ============
CACHE_ENABLED=true
CACHE_TTL_DAYS=30

# ============ Logging ============
LOG_LEVEL=INFO
